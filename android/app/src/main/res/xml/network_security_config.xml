<?xml version="1.0" encoding="utf-8"?>
<!-- O jogo roda em https:// (e a conexão em tempo real em wss://), com o Caddy na frente (docs/HTTPS.md).
     Nada sem criptografia: http:// e ws:// ficam bloqueados. Para testar com um servidor local por http (no PC da
     rede de casa), libere o IP dele num domain-config com cleartextTrafficPermitted="true" só no build de teste. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
